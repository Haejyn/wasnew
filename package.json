{
  "name": "wasnew",
  "version": "0.3.0",
  "description": "Undo layer for AI agents' file operations: journals every move, rename and delete in any folder and undoes them per task, with or without git.",
  "mcpName": "io.github.Haejyn/wasnew",
  "private": true,
  "type": "module",
  "author": "Haejyn",
  "homepage": "https://github.com/Haejyn/wasnew#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haejyn/wasnew.git"
  },
  "bugs": {
    "url": "https://github.com/Haejyn/wasnew/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wasnew": "./bin/wasnew.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "NOTICE",
    "CITATION.cff",
    "llms.txt",
    "assets/icon.svg",
    "assets/icon-512.png",
    "assets/favicon.svg",
    "assets/mark.svg",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "undo",
    "mcp",
    "mcp-server",
    "claude-code",
    "rollback",
    "checkpoint",
    "trash",
    "safe-delete",
    "file-operations",
    "journal",
    "snapshot",
    "agent-safety",
    "backup"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "bench:git": "node scripts/bench-git.mjs",
    "bench:tokens": "node scripts/bench-tokens.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
