{
  "name": "wasnew",
  "version": "0.3.0",
  "description": "Undo what AI agents move and delete, per task. Works outside git too.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "wasnew": "./bin/wasnew.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "assets",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "undo",
    "snapshot",
    "mcp",
    "ai-agent",
    "safety",
    "journal",
    "backup"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
