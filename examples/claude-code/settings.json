{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node /path/to/wasnew/bin/wasnew.js snapshot --if-changed --root \"$WASNEW_ROOT\" -m \"before claude prompt\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node /path/to/wasnew/examples/claude-code/guard.mjs" }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node /path/to/wasnew/examples/claude-code/moved.mjs" }
        ]
      }
    ]
  }
}
